# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hangout_hub"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="change-me-to-a-long-random-string"
NODE_ENV="development"

# ---- Email OTP (Gmail SMTP) ----
# Create a Google App Password: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your.address@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="Hangout Hub <your.address@gmail.com>"

# ---- WhatsApp OTP (optional, via Twilio) ----
# Leave WHATSAPP_ENABLED=false to start with email OTP only (recommended).
WHATSAPP_ENABLED="false"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
DEFAULT_OTP_CHANNEL="EMAIL"
